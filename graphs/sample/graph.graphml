<graph edgedefault="directed"><node id="emergency_fund">
  <data key="d0">Task</data>
  <data key="d1">Liquidity before anything illiquid or locked up</data>
  <data key="d2">policy_v4.2</data>
</node>
<node id="pay_down_high_interest">
  <data key="d0">Task</data>
  <data key="d1">Guaranteed return equal to the interest rate</data>
  <data key="d2">policy_v4.2</data>
</node>
<node id="employer_match_401k">
  <data key="d0">Task</data>
  <data key="d1">Match is an immediate 100% return</data>
  <data key="d2">policy_v4.2</data>
</node>
<node id="roth_ira">
  <data key="d0">Task</data>
  <data key="d1">Tax-free growth once the match is captured</data>
  <data key="d2">policy_v4.2</data>
</node>
<node id="taxable_brokerage">
  <data key="d0">Task</data>
  <data key="d1">Overflow once tax-advantaged space is used</data>
  <data key="d2">policy_v4.2</data>
</node>
<node id="estate_review">
  <data key="d0">Task</data>
  <data key="d1">Beneficiary and titling review</data>
  <data key="d2">policy_v4.2</data>
</node>
<node id="emergency_fund__funded_with_debt">
  <data key="d0">CriteriaNode</data>
  <data key="d3">Does the client have an emergency fund on hand, but is still carrying high-interest debt?</data>
</node>
<node id="emergency_fund__funded_clear">
  <data key="d0">CriteriaNode</data>
  <data key="d3">Does the client have an emergency fund on hand and no high-interest debt?</data>
</node>
<node id="pay_down_high_interest__yes">
  <data key="d0">CriteriaNode</data>
  <data key="d3">Has the client's high-interest debt been paid off?</data>
</node>
<node id="employer_match_401k__roth">
  <data key="d0">CriteriaNode</data>
  <data key="d3">Is a Roth IRA the client's next investment vehicle?</data>
</node>
<node id="employer_match_401k__taxable">
  <data key="d0">CriteriaNode</data>
  <data key="d3">Is a taxable brokerage account the client's next investment vehicle?</data>
</node>
<node id="roth_ira__invest">
  <data key="d0">CriteriaNode</data>
  <data key="d3">After the Roth IRA, does the client want to keep investing?</data>
</node>
<node id="roth_ira__estate">
  <data key="d0">CriteriaNode</data>
  <data key="d3">After the Roth IRA, is the client ready for an estate review?</data>
</node>
