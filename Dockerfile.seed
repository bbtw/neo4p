FROM ubuntu:22.04

RUN apt-get update && \
    apt-get install -y wget gnupg netcat-openbsd openjdk-17-jre-headless

# Add Neo4j GPG key and repo
RUN wget -O - https://debian.neo4j.com/neotechnology.gpg.key | gpg --dearmor > /usr/share/keyrings/neo4j.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/neo4j.gpg] https://debian.neo4j.com stable 5" > /etc/apt/sources.list.d/neo4j.list

# Install only cypher-shell
RUN apt-get update && apt-get install -y cypher-shell

COPY init_neo4j.cypher /seed/init.cypher

ENTRYPOINT ["/bin/bash", "-c"]
CMD ["\
  for i in {1..40}; do \
    echo '[seed] Waiting for Neo4j on bolt://neo4j:7687 (Attempt $i)...'; \
    nc -z neo4j 7687 && break || sleep 3; \
  done; \
  echo '[seed] Neo4j Bolt is accessible. Running cypher-shell...'; \
  cypher-shell -a bolt://neo4j:7687 -u neo4j -p your_password --encryption false -f /seed/init.cypher \
"]
